{
  "name": "streamchat-hub",
  "version": "0.5.0",
  "description": "One merged chat for every platform you stream to",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/tsconfig.json",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "dist:dir": "electron-vite build && electron-builder --win --dir --publish never",
    "release": "electron-vite build && electron-builder --win --publish always",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.1.0",
    "electron-updater": "^6.8.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-virtuoso": "^4.12.0",
    "ws": "^8.18.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^5.5.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ColtonThompson/streamchat-hub.git"
  },
  "author": "Nightleaf"
}
